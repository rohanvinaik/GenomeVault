# Reproducible Benchmark Container for GenomeVault
FROM python:3.11-slim-bookworm

# Set environment for reproducibility
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONHASHSEED=42 \
    GENOMEVAULT_DOCKER=1 \
    GENOMEVAULT_SEED=42 \
    DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN useradd -m -s /bin/bash genomevault && \
    mkdir -p /genomevault/results && \
    chown -R genomevault:genomevault /genomevault

WORKDIR /genomevault

# Copy requirements first for layer caching
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir \
    cryptography==41.0.7 \
    numpy==1.24.3 \
    torch==2.1.0 --index-url https://download.pytorch.org/whl/cpu \
    scikit-learn==1.3.0 \
    scipy==1.11.4 \
    matplotlib==3.7.2

# Copy source code
COPY --chown=genomevault:genomevault . .

# Install package in development mode
RUN pip install -e .

# Switch to non-root user
USER genomevault

# Set up git config for reproducibility
RUN git config --global user.email "benchmark@genomevault.ai" && \
    git config --global user.name "GenomeVault Benchmark"

# Default command
CMD ["python", "reproducible_harness.py"]