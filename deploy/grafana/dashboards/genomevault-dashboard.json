{
  "dashboard": {
    "id": null,
    "title": "GenomeVault Demo Dashboard",
    "tags": ["genomevault", "demo"],
    "timezone": "browser",
    "refresh": "10s",
    "time": {
      "from": "now-15m",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "API Request Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(http_requests_total[5m])",
            "legendFormat": "{{method}} {{endpoint}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Response Times",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "95th percentile"
          },
          {
            "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "median"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "HDC Compression Ratio",
        "type": "stat",
        "targets": [
          {
            "expr": "avg(hdc_compression_ratio)",
            "legendFormat": "Compression Ratio"
          }
        ],
        "gridPos": {"h": 6, "w": 6, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "ZK Proof Generation Time",
        "type": "stat",
        "targets": [
          {
            "expr": "avg(zk_proof_generation_seconds)",
            "legendFormat": "Average Time (s)"
          }
        ],
        "gridPos": {"h": 6, "w": 6, "x": 6, "y": 8}
      },
      {
        "id": 5,
        "title": "PIR Query Latency",
        "type": "stat",
        "targets": [
          {
            "expr": "avg(pir_query_duration_seconds)",
            "legendFormat": "Average Latency (s)"
          }
        ],
        "gridPos": {"h": 6, "w": 6, "x": 12, "y": 8}
      },
      {
        "id": 6,
        "title": "Active Operations",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(active_operations_total)",
            "legendFormat": "Total Active"
          }
        ],
        "gridPos": {"h": 6, "w": 6, "x": 18, "y": 8}
      }
    ]
  }
}