{
  "dashboard": {
    "id": null,
    "uid": "genomevault-pir",
    "title": "GenomeVault - PIR Server Performance",
    "tags": ["genomevault", "pir", "performance", "security"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "10s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "templating": {
      "list": [
        {
          "name": "server_id",
          "type": "query",
          "datasource": "Prometheus",
          "query": "label_values(genomevault_pir_server_health, server_id)",
          "multi": true,
          "includeAll": true,
          "current": {
            "selected": true,
            "text": "All",
            "value": "$__all"
          }
        },
        {
          "name": "trust_domain",
          "type": "query",
          "datasource": "Prometheus",
          "query": "label_values(genomevault_pir_server_health, trust_domain)",
          "multi": false,
          "includeAll": true
        }
      ]
    },
    "panels": [
      {
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "id": 1,
        "title": "PIR Server Health Status",
        "type": "stat",
        "targets": [
          {
            "expr": "genomevault_pir_server_health{server_id=~\"$server_id\"}",
            "legendFormat": "Server {{server_id}} ({{trust_domain}})",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "value": "0", "text": "Unhealthy", "color": "red"},
              {"type": "value", "value": "1", "text": "Healthy", "color": "green"}
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": 0},
                {"color": "green", "value": 1}
              ]
            }
          }
        }
      },
      {
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "id": 2,
        "title": "Privacy Guarantee Status",
        "type": "gauge",
        "targets": [
          {
            "expr": "count(genomevault_pir_server_health == 1)",
            "legendFormat": "Healthy Servers",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 3,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 1},
                {"color": "green", "value": 2}
              ]
            },
            "unit": "none",
            "custom": {
              "neutral": 2
            }
          }
        },
        "options": {
          "showThresholdLabels": true,
          "showThresholdMarkers": true,
          "text": {
            "titleSize": 16,
            "valueSize": 32
          }
        }
      },
      {
        "gridPos": {"h": 10, "w": 24, "x": 0, "y": 8},
        "id": 3,
        "title": "PIR Query Latency (P50, P95, P99)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(genomevault_pir_query_duration_seconds_bucket{server_id=~\"$server_id\"}[5m])) by (le))",
            "legendFormat": "P50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(genomevault_pir_query_duration_seconds_bucket{server_id=~\"$server_id\"}[5m])) by (le))",
            "legendFormat": "P95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(genomevault_pir_query_duration_seconds_bucket{server_id=~\"$server_id\"}[5m])) by (le))",
            "legendFormat": "P99",
            "refId": "C"
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Latency",
            "show": true
          }
        ],
        "xaxis": {
          "show": true
        },
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "nullPointMode": "null",
        "thresholds": [
          {
            "value": 0.01,
            "op": "gt",
            "fill": true,
            "line": true,
            "colorMode": "critical",
            "yaxis": "left"
          }
        ]
      },
      {
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 18},
        "id": 4,
        "title": "Query Rate by Server",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(genomevault_pir_queries_total{server_id=~\"$server_id\"}[5m])) by (server_id)",
            "legendFormat": "Server {{server_id}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "reqps",
            "label": "Queries/sec",
            "show": true
          }
        ]
      },
      {
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 18},
        "id": 5,
        "title": "Response Size Distribution",
        "type": "heatmap",
        "targets": [
          {
            "expr": "sum(rate(genomevault_pir_response_bytes_bucket{server_id=~\"$server_id\"}[5m])) by (le)",
            "format": "heatmap",
            "legendFormat": "{{le}}",
            "refId": "A"
          }
        ],
        "dataFormat": "timeseries",
        "cards": {
          "cardPadding": 2,
          "cardRound": 2
        },
        "color": {
          "mode": "spectrum",
          "scheme": "interpolateBlues"
        },
        "yAxis": {
          "format": "bytes"
        }
      },
      {
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 26},
        "id": 6,
        "title": "Byzantine Faults Detected",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(genomevault_pir_byzantine_faults_total[5m])) by (server_id, fault_type)",
            "legendFormat": "Server {{server_id}} - {{fault_type}}",
            "refId": "A"
          }
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {
                "params": [0],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": ["A", "5m", "now"]
              },
              "reducer": {
                "params": [],
                "type": "avg"
              },
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "60s",
          "handler": 1,
          "name": "Byzantine Fault Alert",
          "noDataState": "no_data",
          "notifications": []
        }
      },
      {
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 26},
        "id": 7,
        "title": "Collusion Attempts",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(increase(genomevault_pir_collusion_attempts_total[1h]))",
            "legendFormat": "Collusion Attempts (1h)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 1},
                {"color": "red", "value": 5}
              ]
            },
            "unit": "short"
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "horizontal",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "fields": "",
            "values": false
          },
          "text": {
            "titleSize": 16,
            "valueSize": 48
          }
        }
      },
      {
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 34},
        "id": 8,
        "title": "Constant-Time Execution Verification",
        "type": "graph",
        "targets": [
          {
            "expr": "stddev_over_time(genomevault_pir_query_duration_seconds{server_id=~\"$server_id\"}[5m])",
            "legendFormat": "Timing Variance - Server {{server_id}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Standard Deviation",
            "show": true
          }
        ],
        "thresholds": [
          {
            "value": 0.001,
            "op": "lt",
            "fill": true,
            "line": true,
            "colorMode": "warning",
            "yaxis": "left"
          }
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {
                "params": [0.001],
                "type": "lt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": ["A", "10m", "now"]
              },
              "reducer": {
                "params": [],
                "type": "avg"
              },
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "60s",
          "handler": 1,
          "name": "Timing Attack Detection",
          "noDataState": "no_data",
          "notifications": []
        }
      },
      {
        "gridPos": {"h": 6, "w": 8, "x": 0, "y": 42},
        "id": 9,
        "title": "Server Reputation Scores",
        "type": "bargauge",
        "targets": [
          {
            "expr": "genomevault_pir_server_reputation{server_id=~\"$server_id\"}",
            "legendFormat": "Server {{server_id}}",
            "refId": "A"
          }
        ],
        "options": {
          "displayMode": "gradient",
          "orientation": "horizontal",
          "showUnfilled": true
        },
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 0.7},
                {"color": "green", "value": 0.9}
              ]
            },
            "unit": "percentunit"
          }
        }
      },
      {
        "gridPos": {"h": 6, "w": 8, "x": 8, "y": 42},
        "id": 10,
        "title": "Query Success Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(rate(genomevault_pir_queries_total{status=\"success\",server_id=~\"$server_id\"}[5m])) / sum(rate(genomevault_pir_queries_total{server_id=~\"$server_id\"}[5m]))",
            "legendFormat": "Success Rate",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 0.95},
                {"color": "green", "value": 0.99}
              ]
            },
            "unit": "percentunit"
          }
        }
      },
      {
        "gridPos": {"h": 6, "w": 8, "x": 16, "y": 42},
        "id": 11,
        "title": "Cache Hit Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(rate(genomevault_pir_cache_hits_total[5m])) / sum(rate(genomevault_pir_queries_total[5m]))",
            "legendFormat": "Cache Hit Rate",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 0.5},
                {"color": "green", "value": 0.8}
              ]
            },
            "unit": "percentunit"
          }
        }
      }
    ]
  },
  "overwrite": true,
  "folderId": 0,
  "message": "GenomeVault PIR Server Performance Dashboard"
}
