\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Differential encoding pipeline.} The system selects population-matched reference genomes, computes variant differences (new mutations, missing variants, genotype differences), applies adaptive chunking strategies, extracts 384-dimensional feature vectors per chunk, and projects to high-dimensional hypervectors via random matrix multiplication. Cryptographic binding with HMAC-SHA256 ensures reference genome integrity and prevents substitution attacks.}}{16}{figure.3}\protected@file@percent }
\newlabel{fig:differential_encoding}{{3}{16}{\textbf {Differential encoding pipeline.} The system selects population-matched reference genomes, computes variant differences (new mutations, missing variants, genotype differences), applies adaptive chunking strategies, extracts 384-dimensional feature vectors per chunk, and projects to high-dimensional hypervectors via random matrix multiplication. Cryptographic binding with HMAC-SHA256 ensures reference genome integrity and prevents substitution attacks}{figure.3}{}}
