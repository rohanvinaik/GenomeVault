\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}Tunable Privacy--Accuracy Trade-off}{14}{subsection.3.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.4.1}Majority Voting Accuracy}{14}{subsubsection.3.4.1}\protected@file@percent }
\newlabel{lemma:consensus_convergence}{{2}{14}{Exponential Consensus Convergence}{theorem.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Consensus accuracy vs. number of runs.} Error rate decreases exponentially with $N$. At $N=5$ runs (10.7s total), accuracy exceeds 99.9\% while maintaining 260 bits privacy entropy per run.}}{15}{figure.3}\protected@file@percent }
\newlabel{fig:consensus}{{3}{15}{\textbf {Consensus accuracy vs. number of runs.} Error rate decreases exponentially with $N$. At $N=5$ runs (10.7s total), accuracy exceeds 99.9\% while maintaining 260 bits privacy entropy per run}{figure.3}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.4.2}Privacy-Accuracy Pareto Frontier}{15}{subsubsection.3.4.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.5}Hyperdimensional Computing: Collision Analysis}{15}{subsection.3.5}\protected@file@percent }
\newlabel{thm:hdc_collision}{{3}{15}{HDC Collision Probability}{theorem.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {HDC collision probability vs. dimension.} For $D \geq 8192$, collision probability $<10^{-4}$ even for databases with millions of genomes. Dimensions $\geq 16384$ provide $<10^{-8}$ collision rate sufficient for global-scale deployment.}}{16}{figure.4}\protected@file@percent }
\newlabel{fig:hdc_collision}{{4}{16}{\textbf {HDC collision probability vs. dimension.} For $D \geq 8192$, collision probability $<10^{-4}$ even for databases with millions of genomes. Dimensions $\geq 16384$ provide $<10^{-8}$ collision rate sufficient for global-scale deployment}{figure.4}{}}
