\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {GenomeVault End-to-End Pipeline.} Raw FASTQ data undergoes quality control, probabilistic alignment, differential encoding, hyperdimensional transformation, zero-knowledge proof generation, secure storage, and information-theoretic private querying. Each stage's latency, compression ratio, and security guarantees are shown. The system achieves 2.15-second total latency with 38.4$\times $ empirical compression and $2^{516}$-bit combined security.}}{6}{figure.1}\protected@file@percent }
\newlabel{fig:pipeline}{{1}{6}{\textbf {GenomeVault End-to-End Pipeline.} Raw FASTQ data undergoes quality control, probabilistic alignment, differential encoding, hyperdimensional transformation, zero-knowledge proof generation, secure storage, and information-theoretic private querying. Each stage's latency, compression ratio, and security guarantees are shown. The system achieves 2.15-second total latency with 38.4$\times $ empirical compression and $2^{516}$-bit combined security}{figure.1}{}}
