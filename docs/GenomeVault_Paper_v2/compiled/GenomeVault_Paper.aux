\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}SHA-256$^2$ Dual-Barrier Security}{12}{subsection.3.2}\protected@file@percent }
\newlabel{lemma:barrier_independence}{{1}{12}{Independence of Security Barriers}{theorem.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {SHA-256$^2$ Dual-Barrier Architecture.} Two independent protection layers: (1) AES-256-GCM encryption of hypervectors, (2) Information-theoretic alignment randomization across reference pool. An attacker must break \textit  {both} layers to recover genomic information, requiring $2^{516}$ operations.}}{13}{figure.2}\protected@file@percent }
\newlabel{fig:dual_barrier}{{2}{13}{\textbf {SHA-256$^2$ Dual-Barrier Architecture.} Two independent protection layers: (1) AES-256-GCM encryption of hypervectors, (2) Information-theoretic alignment randomization across reference pool. An attacker must break \textit {both} layers to recover genomic information, requiring $2^{516}$ operations}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Probabilistic Alignment and Privacy Entropy}{13}{subsection.3.3}\protected@file@percent }
