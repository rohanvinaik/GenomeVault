{
  "name": "@genomevault/sdk",
  "version": "1.0.0",
  "description": "TypeScript/JavaScript SDK for the GenomeVault API",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.js",
    "build:dev": "rollup -c rollup.config.js --environment NODE_ENV:development",
    "dev": "rollup -c rollup.config.js --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint src --ext .ts,.tsx,.js,.jsx --fix",
    "type-check": "tsc --noEmit",
    "docs": "typedoc src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "genomics",
    "privacy",
    "hypervector",
    "zero-knowledge",
    "bioinformatics",
    "genomevault"
  ],
  "author": "GenomeVault Team",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/genomevault/genomevault.git",
    "directory": "sdk/javascript"
  },
  "bugs": {
    "url": "https://github.com/genomevault/genomevault/issues"
  },
  "homepage": "https://genomevault.io",
  "dependencies": {
    "axios": "^1.6.0",
    "form-data": "^4.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "rollup": "^4.5.0",
    "rollup-plugin-dts": "^6.1.0",
    "ts-jest": "^29.1.1",
    "tslib": "^2.6.2",
    "typedoc": "^0.25.4",
    "typescript": "^5.2.2"
  },
  "peerDependencies": {
    "axios": ">=1.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
